  "info": {
    "_postman_id": "d10e9445-6e8d-4823-8e0d-90d33fdf9a21",
    "name": "Contensis Delivery API (HTTP) Content Types Entries API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Contensis Delivery API is a read-only RESTful HTTP API that returns\ncontent as JSON (or as resource files for assets) from a Contensis CMS\nproject. The base URL is the host name of the Contensis instance the\nproject lives on (for example `https://cms.example.contensis.com`). All\nrequests target the `/api/delivery` namespace.\n\n\nContact Support:\n Name: Contensis Help and Docs",
      "type": "text/plain"
    }
  }
